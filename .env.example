# Copie este arquivo para .env (na raiz do projeto) e preencha.
# O .env é ignorado pelo Git. `npm start` e `npm run dev:server` o carregam;
# no Docker Compose, as mesmas variáveis são lidas do .env automaticamente.

# ----- IA (LiteLLM ou outro provedor compatível com OpenAI) -----
# Sem LLM_BASE_URL, os recursos de IA ficam desligados.
LLM_BASE_URL=https://seu-litellm.exemplo.gov.br/v1
LLM_API_KEY=
# Modelo de conversa (assistente "Perguntar" e "Melhorar com IA").
# Use o nome exatamente como aparece no LiteLLM; ao iniciar, o servidor
# lista no log os modelos disponíveis se este não existir.
LLM_MODEL=gpt-4o-mini
# Modelo de embeddings (busca por significado no catálogo).
LLM_EMBEDDING_MODEL=text-embedding-3-small
# Tempo máximo de uma chamada à IA, em milissegundos.
# LLM_TIMEOUT_MS=60000
# Partes que o "Melhorar com IA" pede ao mesmo tempo (1 a 10, padrão 5). Baixe se o provedor responder 429.
# LLM_PARALLEL=5

# ----- Contas -----
# Primeiro administrador, criado só quando ainda não existe nenhum. Entre com este e-mail
# (ou "admin") e esta senha; depois troque a senha em Minha conta e crie as outras pessoas.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Chave que assina as sessões. Sem ela, uma chave aleatória é gerada e guardada em accounts.json.
# SESSION_SECRET=
# Quantos dias a pessoa fica conectada.
# SESSION_DAYS=7
# Pedidos de acesso vão para os administradores com e-mail; se nenhum tiver, para cá.
# ACCESS_REQUESTS_EMAIL=
# Validade, em minutos, do link de "Esqueci minha senha" (precisa de SMTP_URL para chegar).
# RESET_MINUTES=60

# ----- Login com SSO da organização (OpenID Connect; opcional) -----
# Cadastre no provedor o endereço de retorno <PUBLIC_URL>/api/auth/sso/callback.
# OIDC_ISSUER=https://login.exemplo.gov.br/realms/estado
# OIDC_CLIENT_ID=catalogo-de-apis
# OIDC_CLIENT_SECRET=
# Texto do botão na tela de login.
# OIDC_LABEL=Entrar com a conta do Estado
# Só entram e-mails destes domínios (vazio: qualquer um).
# OIDC_ALLOWED_DOMAINS=mg.gov.br
# false: só SSO (sem e-mail e senha, cadastro e "Esqueci minha senha"). Com isso, use em ADMIN_EMAIL
# o seu e-mail da organização para entrar como administrador pelo SSO.
# PASSWORD_LOGIN=true

# ----- Banco de dados (opcional; sem ele, os dados ficam em arquivos JSON) -----
# DATABASE_URL=postgres://catalogo:senha@localhost:5432/catalogo
# Com o docker-compose.dev.yml: postgres://catalogo:<DB_PASSWORD>@127.0.0.1:5434/catalogo
# Usada pelo docker-compose para criar o PostgreSQL:
# DB_PASSWORD=
# Serviço backup do docker-compose: de quantas em quantas horas e por quantos dias guardar.
# BACKUP_EVERY_HOURS=24
# BACKUP_KEEP_DAYS=14

# ----- E-mail ("Acompanhar esta API"; sem SMTP, os e-mails vão para server/data/outbox) -----
# PUBLIC_URL=http://localhost:3000
# SMTP_URL=smtp://usuario:senha@smtp.exemplo.gov.br:587
# Para testar com o MailHog (`docker compose -f docker-compose.yml -f docker-compose.dev.yml up -d db mailhog`, caixa em http://localhost:8025):
# SMTP_URL=smtp://127.0.0.1:1025
# MAIL_FROM=Catálogo de APIs <nao-responda@exemplo.gov.br>

# ----- Contato indicado quando o assistente não encontra resposta -----
# CATALOG_CONTACT_NAME=Time do Catálogo de APIs
# CATALOG_CONTACT_EMAIL=
