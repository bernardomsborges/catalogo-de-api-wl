    "environments": [
      { "name": "Produção", "url": "https://api.exemplo.com/notificacoes/v1" },
      { "name": "Sandbox", "url": "https://sandbox.exemplo.com/notificacoes/v1" }
    ],
    "auth": { "type": "apiKey", "headerName": "X-API-Key", "tokenUrl": "", "scopes": "", "instructions": "Gere a chave no painel da plataforma em **Configurações → Chaves de API**." },
    "rateLimit": "100 requisições/segundo",
    "sla": "99,5% de disponibilidade mensal",
    "endpoints": [
      {
        "id": "ep-nt-1",
        "method": "POST",
        "path": "/mensagens",
        "summary": "Enviar mensagem",
        "description": "Envia uma mensagem usando um template cadastrado.",
        "parameters": [],
        "requestBody": "{\n  \"canal\": \"email\",\n  \"template\": \"boas-vindas\",\n  \"destinatario\": \"cliente@exemplo.com\",\n  \"variaveis\": { \"nome\": \"Maria\" }\n}",
        "responses": [
          { "status": 201, "description": "Mensagem enfileirada.", "body": "{ \"id\": \"msg_789\", \"status\": \"enfileirada\" }" },
          { "status": 400, "description": "Template ou canal inválido.", "body": "{ \"error\": \"invalid_template\" }" }
        ]
      },
      {
        "id": "ep-nt-2",
        "method": "GET",
        "path": "/mensagens/{id}",
        "summary": "Consultar mensagem",
        "description": "Retorna o status de entrega da mensagem.",
        "parameters": [
          { "name": "id", "in": "path", "type": "string", "required": true, "description": "Identificador da mensagem.", "example": "msg_789" }
        ],
        "requestBody": "",
        "responses": [
          { "status": 200, "description": "Mensagem encontrada.", "body": "{ \"id\": \"msg_789\", \"status\": \"entregue\" }" }
        ]
      }
    ],
    "guides": [],
    "changelog": [{ "version": "1.4.0", "date": "2026-08-02", "notes": "Suporte a mensagens push." }],
    "createdAt": "2026-02-01T12:00:00.000Z",
    "updatedAt": "2026-08-02T12:00:00.000Z"
  },
