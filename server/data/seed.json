[
  {
    "id": "8f1c2a10-0001-4a00-9000-000000000001",
    "slug": "workflows",
    "name": "Workflows",
    "summary": "Crie, dispare e acompanhe automações da plataforma a partir dos seus sistemas.",
    "description": "A **API de Workflows** permite que sistemas externos iniciem automações cadastradas na plataforma e acompanhem a execução em tempo real.\n\n### Casos de uso\n- Disparar um fluxo de aprovação quando um pedido é criado no ERP\n- Consultar o status de uma execução para exibir no seu portal\n- Listar as automações disponíveis para um time\n\n> Exemplo de API cadastrada para demonstração — edite ou remova pelo painel admin.",
    "category": "Automação",
    "tags": ["workflows", "execuções", "orquestração"],
    "status": "estavel",
    "version": "2.1.0",
    "owner": "Time de Plataforma",
    "contactEmail": "plataforma@exemplo.com",
    "baseUrl": "https://api.exemplo.com/workflows/v2",
    "environments": [
      { "name": "Produção", "url": "https://api.exemplo.com/workflows/v2" },
      { "name": "Homologação", "url": "https://hml-api.exemplo.com/workflows/v2" }
    ],
    "auth": {
      "type": "oauth2",
      "headerName": "",
      "tokenUrl": "https://auth.exemplo.com/oauth2/token",
      "scopes": "workflows:read workflows:execute",
      "instructions": "Solicite um **client_id** e **client_secret** ao Time de Plataforma pelo portal de acessos."
    },
    "rateLimit": "600 requisições/minuto por cliente",
    "sla": "99,9% de disponibilidade mensal",
    "endpoints": [
      {
        "id": "ep-wf-1",
        "method": "GET",
        "path": "/workflows",
        "summary": "Listar workflows",
        "description": "Retorna os workflows que o cliente autenticado pode executar.",
        "parameters": [
          { "name": "page", "in": "query", "type": "integer", "required": false, "description": "Página (começa em 1).", "example": "1" },
          { "name": "status", "in": "query", "type": "string", "required": false, "description": "Filtra por status: ativo ou inativo.", "example": "ativo" }
        ],
        "requestBody": "",
        "responses": [
          { "status": 200, "description": "Lista paginada de workflows.", "body": "{\n  \"data\": [\n    { \"id\": \"wf_123\", \"name\": \"Aprovação de pedido\", \"status\": \"ativo\" }\n  ],\n  \"page\": 1,\n  \"total\": 1\n}" },
          { "status": 401, "description": "Token ausente ou inválido.", "body": "{ \"error\": \"unauthorized\" }" }
        ]
      },
      {
        "id": "ep-wf-2",
        "method": "POST",
        "path": "/workflows/{workflowId}/executions",
        "summary": "Disparar execução",
        "description": "Inicia uma nova execução do workflow com os dados de entrada informados. A execução é assíncrona: use o endpoint de consulta para acompanhar.",
        "parameters": [
          { "name": "workflowId", "in": "path", "type": "string", "required": true, "description": "Identificador do workflow.", "example": "wf_123" },
          { "name": "Idempotency-Key", "in": "header", "type": "string", "required": false, "description": "Chave para evitar execuções duplicadas.", "example": "pedido-9876" }
        ],
        "requestBody": "{\n  \"input\": {\n    \"pedidoId\": \"9876\",\n    \"valor\": 1500.0\n  }\n}",
        "responses": [
          { "status": 202, "description": "Execução aceita.", "body": "{\n  \"executionId\": \"ex_456\",\n  \"status\": \"em_andamento\"\n}" },
          { "status": 404, "description": "Workflow não encontrado.", "body": "{ \"error\": \"workflow_not_found\" }" },
          { "status": 422, "description": "Dados de entrada inválidos.", "body": "{ \"error\": \"invalid_input\", \"fields\": [\"valor\"] }" }
        ]
      },
      {
        "id": "ep-wf-3",
        "method": "GET",
        "path": "/executions/{executionId}",
        "summary": "Consultar execução",
        "description": "Retorna o status atual e o resultado de uma execução.",
        "parameters": [
          { "name": "executionId", "in": "path", "type": "string", "required": true, "description": "Identificador da execução.", "example": "ex_456" }
        ],
        "requestBody": "",
        "responses": [
          { "status": 200, "description": "Execução encontrada.", "body": "{\n  \"executionId\": \"ex_456\",\n  \"status\": \"concluida\",\n  \"output\": { \"aprovado\": true }\n}" }
        ]
      }
    ],
    "guides": [
      {
        "title": "Disparando um workflow a partir do ERP",
        "content": "1. Obtenha um token OAuth2 com o escopo `workflows:execute`.\n2. Chame `POST /workflows/{workflowId}/executions` enviando os dados do pedido.\n3. Guarde o `executionId` retornado.\n4. Consulte `GET /executions/{executionId}` até o status ser `concluida` ou `falhou`.\n\n**Dica:** envie o cabeçalho `Idempotency-Key` com o número do pedido para não disparar o fluxo duas vezes."
      }
    ],
    "changelog": [
      { "version": "2.1.0", "date": "2026-09-15", "notes": "Novo cabeçalho Idempotency-Key no disparo de execuções." },
      { "version": "2.0.0", "date": "2026-03-01", "notes": "Migração para OAuth2 e paginação padronizada." }
    ],
    "createdAt": "2026-01-10T12:00:00.000Z",
    "updatedAt": "2026-09-15T12:00:00.000Z"
  },
  {
    "id": "8f1c2a10-0002-4a00-9000-000000000002",
